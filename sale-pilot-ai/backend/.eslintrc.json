{
  "env": {
    "node": true,
    "es2021": true,
    "browser": true
  },
  "extends": [
    "standard"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "ignorePatterns": [
    "node_modules",
    "public"
  ],
  "rules": {
    "quotes": ["error", "single", { "allowTemplateLiterals": true }]
  }
}
